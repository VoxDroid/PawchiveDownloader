{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawchive Downloader",
  "version": "1.0.0",
  "identifier": "io.github.voxdroid.pawchivedownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pawchive Downloader",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0c0e13",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://img.pawchive.pw https://pawchive.pw; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "VoxDroid",
    "copyright": "Copyright (c) 2026 VoxDroid",
    "category": "Utility",
    "shortDescription": "Download from Pawchive",
    "longDescription": "Pawchive Downloader downloads posts, attachments and whole creators from Pawchive with resumable transfers, ZIP archives, a watchlist and polite rate limits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Japanese",
          "Korean",
          "SimpChinese",
          "Spanish",
          "PortugueseBR",
          "Russian",
          "German",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {}
}
